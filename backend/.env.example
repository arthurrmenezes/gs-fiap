# SpecRadar backend — copie para .env e preencha (opcional).
# Sem as chaves abaixo a API roda em MODO DEMO (dados offline da Ranger Raptor).
# Nunca commite um .env real.

# --- LLM (extração) ---
ANTHROPIC_API_KEY=
SPECRADAR_LLM_MODEL=claude-opus-4-8

# --- Busca de fontes (Google Custom Search) ---
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- App ---
SPECRADAR_ENV=dev
SPECRADAR_LOG_LEVEL=INFO
