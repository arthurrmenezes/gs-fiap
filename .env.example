# SpecRadar — environment template. Copy to .env and fill in.
# Never commit a real .env.

# --- LLM (extraction) ---
ANTHROPIC_API_KEY=
SPECRADAR_LLM_MODEL=claude-opus-4-8

# --- BigQuery (storage) ---
GOOGLE_CLOUD_PROJECT=
BQ_DATASET=specradar
GCP_SA_KEY_PATH=

# --- Source discovery (search) ---
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- App behaviour ---
SPECRADAR_ENV=dev
SPECRADAR_LOG_LEVEL=INFO
# Use Playwright fallback only when a page requires JS rendering.
SPECRADAR_ALLOW_PLAYWRIGHT=false
